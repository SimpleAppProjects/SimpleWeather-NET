<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="SimpleWeather.NET.Controls.ForecastBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:databinding="using:SimpleWeather.NET.DataBinding"
    xmlns:graphs="using:SimpleWeather.NET.Controls.Graphs"
    xmlns:icons="using:SimpleWeather.Icons"
    xmlns:local="using:SimpleWeather.NET.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="using:System"
    Padding="4"
    d:DataContext="{d:DesignInstance Type=graphs:BarGraphEntry}"
    mc:Ignorable="d">

    <StackPanel
        MinWidth="60"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Orientation="Vertical">
        <Grid
            x:Name="InnerBar"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Rectangle
                x:Name="Bar"
                Width="24"
                HorizontalAlignment="Center"
                Fill="{x:Bind Data.FillColor, Mode=OneWay, Converter={StaticResource color2SolidColorConverter}}" />
            <local:IconControl
                x:Name="BarIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Top"
                Foreground="White"
                IconHeight="30"
                IconProvider="wi-erik-flowers"
                IconWidth="30"
                RenderTransformOrigin="0.5,0.5"
                ShowAsMonochrome="True"
                Visibility="Visible">
                <local:IconControl.RenderTransform>
                    <RotateTransform Angle="{x:Bind Data.XIconRotation, Mode=OneWay}" />
                </local:IconControl.RenderTransform>
            </local:IconControl>
        </Grid>
        <TextBlock
            x:Name="BarValue"
            Padding="4"
            HorizontalAlignment="Center"
            FontSize="14"
            HorizontalTextAlignment="Center"
            MaxLines="1"
            Text="{x:Bind Data.EntryData.YLabel, Mode=OneWay}" />
        <TextBlock
            x:Name="BarDate"
            Padding="4"
            HorizontalAlignment="Center"
            FontSize="14"
            HorizontalTextAlignment="Center"
            MaxLines="1"
            Text="{x:Bind Data.XLabel, Mode=OneWay}" />
    </StackPanel>
</UserControl>
