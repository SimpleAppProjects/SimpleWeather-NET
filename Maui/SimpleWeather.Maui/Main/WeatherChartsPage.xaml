<?xml version="1.0" encoding="utf-8"?>

<viewModels:ViewModelPage
    x:Class="SimpleWeather.Maui.Main.WeatherChartsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res_strings="clr-namespace:SimpleWeather.Resources.Strings;assembly=SimpleWeather.Shared"
    xmlns:localActions="clr-namespace:SimpleWeather.Maui.Actions"
    xmlns:localControls="clr-namespace:SimpleWeather.Maui.Controls"
    xmlns:local="clr-namespace:SimpleWeather.Maui.Main"
    xmlns:controls="clr-namespace:SimpleWeather.NET.Controls"
    xmlns:graphs="clr-namespace:SimpleWeather.NET.Controls.Graphs"
    xmlns:graphPanels="clr-namespace:SimpleWeather.Maui.Controls.Graphs"
    xmlns:commonVM="clr-namespace:SimpleWeather.Common.ViewModels;assembly=SimpleWeather.Common"
    xmlns:converters="clr-namespace:SimpleWeather.Maui.Converters"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:viewModels="clr-namespace:SimpleWeather.Maui.ViewModels"
    local:AppShell.AppBarIsVisible="True"
    x:Name="ChartsPage">

    <ContentPage.Resources>
        <converters:DoubleToBooleanConverter x:Key="invValueBooleanConverter" GreaterThan="0" IsInverse="True" />
        <converters:ObjectToCollectionConverter x:Key="objToCollectionConv" />
        <converters:GraphDataLabelConverter x:Key="graphDataLabelConverter" />
        <DataTemplate x:Key="LineViewDataTemplate" x:DataType="{x:Type graphs:LineViewData}">
            <Frame CornerRadius="16" HasShadow="False" BorderColor="Transparent" Padding="0,4"
                   Margin="{OnIdiom Default='4,0', Desktop='16, 0'}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource LightCompositeFrameBackground}, Dark={StaticResource DarkCompositeFrameBackground}}">
                <VerticalStackLayout>
                    <Label
                        Padding="16,10"
                        FontSize="16"
                        FontFamily="OpenSansSemibold"
                        Text="{Binding GraphLabel}" />
                    <graphPanels:ForecastGraphPanel Margin="16,0" GraphData="{Binding}" />
                </VerticalStackLayout>
            </Frame>
        </DataTemplate>
        <DataTemplate x:Key="BarChartDataTemplate" x:DataType="{x:Type controls:ForecastGraphViewModel}">
            <Frame CornerRadius="16" HasShadow="False" BorderColor="Transparent" Padding="0,4"
                   Margin="{OnIdiom Default='4,0', Desktop='16, 0'}"
                   BackgroundColor="{AppThemeBinding Light={StaticResource LightCompositeFrameBackground}, Dark={StaticResource DarkCompositeFrameBackground}}">
                <VerticalStackLayout>
                    <Label
                        Padding="16,10"
                        FontSize="16"
                        FontFamily="OpenSansSemibold"
                        Text="{Binding GraphData, Converter={StaticResource graphDataLabelConverter}}" />
                    <localControls:ForecastBarGraphView Margin="16,0"
                                                        HorizontalOptions="Fill"
                                                        BindingContext="{Binding GraphData}"
                                                        ForecastType="{Binding ForecastType, Source={RelativeSource AncestorType={x:Type controls:ForecastGraphViewModel}}}"
                                                        GraphHeight="250" />
                </VerticalStackLayout>
            </Frame>
        </DataTemplate>
        <local:ChartsDataTemplateSelector
            x:Key="chartsDataTemplateSelector"
            LineViewTemplate="{StaticResource LineViewDataTemplate}"
            BarChartTemplate="{StaticResource BarChartDataTemplate}" />
    </ContentPage.Resources>

    <Grid>
        <CollectionView
            x:Name="ListControl"
            Margin="0,8,0,0"
            IsGrouped="False"
            CanMixGroups="False"
            CanReorderItems="False"
            ItemSizingStrategy="MeasureAllItems"
            SelectionMode="None"
            ItemsSource="{Binding ChartsView.GraphModels, Source={x:Reference ChartsPage}, x:DataType={x:Type local:WeatherChartsPage}}"
            ItemTemplate="{StaticResource chartsDataTemplateSelector}"
            ChildAdded="ListControl_ChildAdded">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.Footer>
                <Rectangle HeightRequest="16" />
            </CollectionView.Footer>
        </CollectionView>
        <ActivityIndicator
            x:Name="ContentIndicator"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            IsRunning="True"
            IsVisible="True">
            <ActivityIndicator.Triggers>
                <DataTrigger TargetType="ActivityIndicator" Binding="{Binding Source={RelativeSource Mode=Self}, Path=IsRunning, x:DataType=ActivityIndicator}" Value="False">
                    <DataTrigger.ExitActions>
                        <localActions:FadeTriggerAction StartsFrom="1" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger TargetType="ActivityIndicator" Binding="{Binding Source={RelativeSource Mode=Self}, Path=IsRunning, x:DataType=ActivityIndicator}" Value="True">
                    <DataTrigger.EnterActions>
                        <localActions:FadeTriggerAction StartsFrom="0" />
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </ActivityIndicator.Triggers>
        </ActivityIndicator>
    </Grid>
</viewModels:ViewModelPage>