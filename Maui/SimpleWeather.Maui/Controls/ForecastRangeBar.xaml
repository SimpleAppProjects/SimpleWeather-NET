<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SimpleWeather.Maui.Controls"
             xmlns:graphs="clr-namespace:SimpleWeather.NET.Controls.Graphs"
             xmlns:icons="clr-namespace:SimpleWeather.Icons;assembly=SimpleWeather.Shared"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             x:Class="SimpleWeather.Maui.Controls.ForecastRangeBar"
             x:DataType="graphs:ForecastRangeBarEntry"
             Padding="{OnIdiom Default=4, Phone=0}">
    <VerticalStackLayout
        HorizontalOptions="Center" VerticalOptions="End"
        MinimumWidthRequest="{OnIdiom Default=80, Phone=60}">
        <Grid
            x:Name="InnerBar"
            HorizontalOptions="Center"
            VerticalOptions="Fill">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label
                x:Name="BarHi"
                Grid.Row="0"
                HorizontalOptions="Center"
                FontSize="{OnIdiom Phone=14, Default=16}"
                MaxLines="1"
                Padding="4"
                Text="{Binding HiTempData.YLabel, Mode=OneWay}" />
            <RoundRectangle
                x:Name="RangeBar"
                Grid.Row="1"
                Aspect="None"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                CornerRadius="4"
                WidthRequest="8" />
            <Label
                x:Name="BarLo"
                Grid.Row="2"
                HorizontalOptions="Center"
                FontSize="{OnIdiom Phone=14, Default=16}"
                MaxLines="1"
                Padding="4"
                Text="{Binding LoTempData.YLabel, Mode=OneWay}" />
        </Grid>
        <HorizontalStackLayout
            x:Name="BarPoP"
            MinimumHeightRequest="16"
            Padding="5"
            HorizontalOptions="Center"
            VerticalOptions="Start">
            <controls:IconControl
                IconWidth="{OnIdiom Default=32, Phone=16}"
                IconHeight="{OnIdiom Default=32, Phone=16}"
                IconColor="{DynamicResource SimpleBlueLight}"
                ForceBitmapIcon="True"
                ShowAsMonochrome="True"
                IsVisible="{Binding PoP, Converter={StaticResource objectBooleanConverter}}"
                WeatherIcon="{x:Static icons:WeatherIcons.UMBRELLA}" />
            <Label
                Margin="5,0,0,0"
                FontSize="{OnIdiom Default=14, Phone=12}"
                TextColor="{DynamicResource SimpleBlueLight}"
                VerticalTextAlignment="Center"
                MaxLines="1"
                Text="{Binding PoP, StringFormat='{0}%', Mode=OneWay}"
                IsVisible="{Binding PoP, Converter={StaticResource objectBooleanConverter}}" />
        </HorizontalStackLayout>
        <controls:IconControl
            x:Name="BarIcon"
            IconWidth="{OnIdiom Phone=36, Tablet=42, Default=50}"
            IconHeight="{OnIdiom Phone=36, Tablet=42, Default=50}"
            HorizontalOptions="Center"
            Rotation="{Binding XIconRotation, Mode=OneWay}"
            AnchorX="0.5"
            AnchorY="0.5"
            ShouldAnimate="True"
            WeatherIcon="{Binding XWeatherIcon, Mode=OneWay}"
            IsVisible="{Binding XWeatherIcon, Converter={StaticResource objectBooleanConverter}, Mode=OneWay}"/>
        <Label
            x:Name="BarDate"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            FontSize="{OnIdiom Phone=14, Default=16}"
            MaxLines="1"
            Padding="4"
            Text="{Binding XLabel, Mode=OneWay}" />
    </VerticalStackLayout>
</ContentView>